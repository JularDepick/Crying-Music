# API Service
API_HOST=0.0.0.0
API_PORT=26714
CLIENT_SECRET=YOURS
# 数据库文件: 留空即落在 ../data/cryingmusic.sqlite
DB_FILE=

# 验证码策略
CODE_TTL_SECONDS=600
SEND_COOLDOWN_SECONDS=60
SEND_DAILY_LIMIT=10
VERIFY_MAX_ATTEMPTS=5
BODY_LIMIT_BYTES=8192

# 登录状态与听歌时长
SESSION_KEEP_DAYS=7
LISTEN_CHUNK_SECONDS=10
LISTEN_DAILY_MAX_SECONDS=18000
LISTEN_COOLDOWN_SECONDS=5

# SMTP Config
SMTP_HOST=SMTP_YOUR_DOMAIN
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_EMAIL@DOMAIN
SMTP_PASSWORD=YOUR_PASSWORD
SMTP_SIGNATURE=YOUR_SIGNATURE
